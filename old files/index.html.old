<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Bible & Commentary Reader</title>
  <!-- Load Marked.js for fast client-side Markdown parsing -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <style>
    :root {
      --bg: #f8f9fa;
      --panel-bg: #ffffff;
      --border: #dee2e6;
      --primary: #2b579a;
      --highlight: #fff3cd;
      --text: #212529;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* Top Navigation Bar */
    header {
      background: var(--panel-bg);
      border-bottom: 1px solid var(--border);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }
    .nav-controls { display: flex; align-items: center; gap: 10px; }
    select, button {
      padding: 6px 12px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: #fff;
      font-size: 14px;
      cursor: pointer;
    }
    button:hover { background: #f1f3f5; }
    .active-filter {
      font-size: 13px;
      color: #555;
      background: #e9ecef;
      padding: 4px 10px;
      border-radius: 12px;
    }
    /* Split Screen Layout */
    main {
      display: flex;
      flex: 1;
      overflow: hidden;
    }
    .pane {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
    }
    .bible-pane {
      border-right: 1px solid var(--border);
      background: var(--panel-bg);
      line-height: 1.75;
      font-size: 17px;
    }
    .commentary-pane {
      background: var(--bg);
    }
    /* Bible Verses */
    .verse {
      padding: 4px 6px;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.15s;
    }
    .verse:hover { background: #f1f3f5; }
    .verse.selected { background: var(--highlight); }
    .verse-num {
      font-weight: 700;
      font-size: 12px;
      color: var(--primary);
      vertical-align: super;
      margin-right: 4px;
    }
    /* Commentary Cards */
    .comm-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }
    .comm-card {
      background: var(--panel-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      margin-bottom: 12px;
      overflow: hidden;
    }
    .comm-card-header {
      padding: 12px 16px;
      background: #f8f9fa;
      border-bottom: 1px solid var(--border);
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      user-select: none;
    }
    .comm-card-header:hover { background: #e9ecef; }
    .comm-card-body {
      padding: 16px;
      line-height: 1.6;
      font-size: 15px;
    }
    .comm-card.minimized .comm-card-body {
      display: none;
    }
    .comm-card.minimized .comm-card-header {
      border-bottom: none;
    }
    .comm-verse-block {
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px dashed #eee;
    }
    .comm-verse-block:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .empty-msg { color: #888; font-style: italic; }

    /* Markdown Content Styling inside Commentary Cards */
    .comm-verse-label {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      color: var(--primary);
      background: #eef2f9;
      padding: 2px 8px;
      border-radius: 4px;
      margin-bottom: 8px;
    }
    .comm-markdown p {
      margin-bottom: 10px;
    }
    .comm-markdown p:last-child {
      margin-bottom: 0;
    }
    .comm-markdown ul, .comm-markdown ol {
      margin: 8px 0 12px 24px;
    }
    .comm-markdown li {
      margin-bottom: 4px;
    }
    .comm-markdown blockquote {
      border-left: 3px solid var(--primary);
      padding-left: 12px;
      color: #555;
      margin: 8px 0;
      font-style: italic;
    }
  </style>
</head>
<body>

  <header>
    <div class="nav-controls">
      <strong>Passage:</strong>
      <select id="bookSelect"></select>
      <select id="chapterSelect"></select>
      <button id="prevChapterBtn">&larr; Prev</button>
      <button id="nextChapterBtn">Next &rarr;</button>
      <span id="filterBadge" class="active-filter">Showing: Full Chapter</span>
      <button id="clearVerseBtn" style="display:none;">Show Full Chapter</button>
    </div>
    <div class="nav-controls">
      <button id="expandAllBtn">Expand All</button>
      <button id="minimizeAllBtn">Minimize All</button>
    </div>
  </header>

  <main>
    <!-- Left: Bible Text -->
    <div class="pane bible-pane" id="bibleContainer"></div>

    <!-- Right: Commentaries -->
    <div class="pane commentary-pane">
      <div class="comm-header-bar">
        <h3 id="commTitle">Commentaries</h3>
        <small id="loadedFilesCount"></small>
      </div>
      <div id="commentariesContainer"></div>
    </div>
  </main>

  <script>
    let booksData = [];
    let currentBook = "";
    let currentChapter = 1;
    let currentVerse = null; // null = show entire chapter
    let currentBookCommentaries = []; // Cached only for the active book
    let minimizedState = {}; // Tracks open/minimized state per author

    const bookSelect = document.getElementById('bookSelect');
    const chapterSelect = document.getElementById('chapterSelect');
    const bibleContainer = document.getElementById('bibleContainer');
    const commentariesContainer = document.getElementById('commentariesContainer');
    const filterBadge = document.getElementById('filterBadge');
    const clearVerseBtn = document.getElementById('clearVerseBtn');
    const loadedFilesCount = document.getElementById('loadedFilesCount');

    // 1. Initialize App
    async function init() {
      const res = await fetch('/api/books');
      booksData = await res.json();

      booksData.forEach(b => {
        const opt = document.createElement('option');
        opt.value = b.name;
        opt.textContent = b.name;
        bookSelect.appendChild(opt);
      });

      if (booksData.length > 0) {
        await selectBook(booksData[0].name);
      }
    }

    // 2. Load a Book (fetches ONLY that book's commentaries)
    async function selectBook(bookName) {
      currentBook = bookName;
      bookSelect.value = bookName;

      const bookObj = booksData.find(b => b.name === bookName);
      chapterSelect.innerHTML = '';
      bookObj.chapters.forEach(ch => {
        const opt = document.createElement('option');
        opt.value = ch;
        opt.textContent = `Chapter ${ch}`;
        chapterSelect.appendChild(opt);
      });

      // Lazy-load commentaries for this book only
      commentariesContainer.innerHTML = '<p class="empty-msg">Loading book commentaries...</p>';
      const commRes = await fetch(`/api/commentaries/${encodeURIComponent(bookName)}`);
      currentBookCommentaries = await commRes.json();
      loadedFilesCount.textContent = `${currentBookCommentaries.length} file(s) loaded for ${bookName}`;

      await selectChapter(bookObj.chapters[0]);
    }

    // 3. Load a Chapter
    async function selectChapter(chapterNum) {
      currentChapter = parseInt(chapterNum, 10);
      chapterSelect.value = currentChapter;
      currentVerse = null;
      updateFilterUI();

      const res = await fetch(`/api/bible/${encodeURIComponent(currentBook)}/${currentChapter}`);
      const verses = await res.json();

      bibleContainer.innerHTML = '';
      Object.entries(verses).forEach(([vNum, vText]) => {
        const span = document.createElement('div');
        span.className = 'verse';
        span.dataset.verse = vNum;
        span.innerHTML = `<span class="verse-num">${vNum}</span> ${vText}`;
        span.addEventListener('click', () => selectVerse(parseInt(vNum, 10)));
        bibleContainer.appendChild(span);
      });

      renderCommentaries();
    }

    // 4. Sync to a Specific Verse (or toggle back to full chapter)
    function selectVerse(verseNum) {
      if (currentVerse === verseNum) {
        currentVerse = null; // Deselect if clicked again
      } else {
        currentVerse = verseNum;
      }

      document.querySelectorAll('.verse').forEach(el => {
        el.classList.toggle('selected', parseInt(el.dataset.verse, 10) === currentVerse);
      });

      updateFilterUI();
      renderCommentaries();
    }

    function updateFilterUI() {
      if (currentVerse) {
        filterBadge.textContent = `Showing: ${currentBook} ${currentChapter}:${currentVerse}`;
        clearVerseBtn.style.display = 'inline-block';
      } else {
        filterBadge.textContent = `Showing: ${currentBook} ${currentChapter} (All Verses)`;
        clearVerseBtn.style.display = 'none';
      }
    }

    // 5. Extract Commentary Content from JSON
    // Supports common JSON structures automatically
    // Clean up trailing StudyLight.org scraped footer text if present
    // Configure Marked.js so single line breaks (\n) render as <br>
    marked.setOptions({
        breaks: true,
        gfm: true
    });

        // Clean up scraped footer text and normalize tab-bullets for Markdown
    function cleanCommentaryString(str) {
        if (typeof str !== 'string') return JSON.stringify(str);
        return str
            // 1. Strip trailing StudyLight.org scraped footer if present
            .replace(/\s*Back to top[\s\S]*$/i, '')
            // 2. Convert "\t• " or leading "• " into standard Markdown list items ("- ")
            //    (Prevents Markdown from treating "\t" as an indented code block)
            .replace(/^[ \t]*•[ \t]*/gm, '- ')
            .trim();
    }

    // 5. Extract Commentary Content from JSON
    function extractCommentaryText(data, chapter, verse) {
      if (!data || typeof data !== 'object') return [];

      const chStr = String(chapter);
      const vStr = verse ? String(verse) : null;

      let root = data.chapters || data.commentary || data;

      // Unwrap top-level book key if present (e.g., { "Jonah": { "1": { "1": "..." } } })
      if (!root[chStr]) {
        const topKeys = Object.keys(root);
        // Check if a top-level key matches the current book name (case-insensitive, handling Psalm/Psalms)
        const matchingBookKey = topKeys.find(k => {
          const kClean = k.toLowerCase().trim();
          const bClean = currentBook.toLowerCase().trim();
          return kClean === bClean ||
                 (bClean.startsWith('psalm') && kClean.startsWith('psalm'));
        });

        if (matchingBookKey && typeof root[matchingBookKey] === 'object') {
          root = root[matchingBookKey];
        } else if (topKeys.length === 1 && typeof root[topKeys[0]] === 'object') {
          // Fallback: if there is only one top-level key in the file, unwrap it
          root = root[topKeys[0]];
        }
      }

      // Now root points to the chapters object: { "1": { "1": "...", "2": "..." }, "2": { ... } }
      if (root[chStr] && typeof root[chStr] === 'object') {
        const chObj = root[chStr].verses || root[chStr];
        if (vStr) {
          return chObj[vStr]
            ? [{ verse: vStr, text: cleanCommentaryString(chObj[vStr]) }]
            : [];
        }
        // Return all verses in the chapter, sorted numerically
        return Object.entries(chObj)
          .sort((a, b) => parseInt(a[0], 10) - parseInt(b[0], 10))
          .map(([v, t]) => ({ verse: v, text: cleanCommentaryString(t) }));
      }

      return [];
    }

    // 6. Render Commentaries with Minimize/Expand Support
    function renderCommentaries() {
      commentariesContainer.innerHTML = '';

      if (currentBookCommentaries.length === 0) {
        commentariesContainer.innerHTML = `<p class="empty-msg">No commentary files found in <code>commentaries_json/</code> for ${currentBook}.</p>`;
        return;
      }

      currentBookCommentaries.forEach(comm => {
        const entries = extractCommentaryText(comm.data, currentChapter, currentVerse);
        const isMinimized = minimizedState[comm.id] === true;

        const card = document.createElement('div');
        card.className = `comm-card ${isMinimized ? 'minimized' : ''}`;
        card.dataset.id = comm.id;

        const header = document.createElement('div');
        header.className = 'comm-card-header';
        header.innerHTML = `
          <span>${comm.author} <small style="color:#666; font-weight:normal;">(${entries.length} note${entries.length === 1 ? '' : 's'})</small></span>
          <span class="toggle-icon">${isMinimized ? '[+]' : '[–]'}</span>
        `;

        header.addEventListener('click', () => {
          const nowMinimized = card.classList.toggle('minimized');
          minimizedState[comm.id] = nowMinimized;
          header.querySelector('.toggle-icon').textContent = nowMinimized ? '[+]' : '[–]';
        });

        const body = document.createElement('div');
        body.className = 'comm-card-body';

        if (entries.length === 0) {
          body.innerHTML = `<p class="empty-msg">No commentary for this selection.</p>`;
        } else {
          entries.forEach(entry => {
            const block = document.createElement('div');
            block.className = 'comm-verse-block';

            const rawText = typeof entry.text === 'object'
              ? JSON.stringify(entry.text)
              : entry.text;

            // Parse the Markdown into HTML
            const renderedHtml = marked.parse(rawText);

            block.innerHTML = `
              <div class="comm-verse-label">Verse ${entry.verse}</div>
              <div class="comm-markdown">${renderedHtml}</div>
            `;
            body.appendChild(block);
          });
        }

        card.appendChild(header);
        card.appendChild(body);
        commentariesContainer.appendChild(card);
      });
    }

    // Event Listeners
    bookSelect.addEventListener('change', e => selectBook(e.target.value));
    chapterSelect.addEventListener('change', e => selectChapter(e.target.value));
    clearVerseBtn.addEventListener('click', () => selectVerse(currentVerse));

    document.getElementById('prevChapterBtn').addEventListener('click', () => {
      if (currentChapter > 1) selectChapter(currentChapter - 1);
    });

    document.getElementById('nextChapterBtn').addEventListener('click', () => {
      const bookObj = booksData.find(b => b.name === currentBook);
      if (currentChapter < bookObj.chapters.length) selectChapter(currentChapter + 1);
    });

    document.getElementById('expandAllBtn').addEventListener('click', () => {
      currentBookCommentaries.forEach(c => minimizedState[c.id] = false);
      renderCommentaries();
    });

    document.getElementById('minimizeAllBtn').addEventListener('click', () => {
      currentBookCommentaries.forEach(c => minimizedState[c.id] = true);
      renderCommentaries();
    });

    init();
  </script>
</body>
</html>